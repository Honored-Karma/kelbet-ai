# Application
APP_ENV=development
LOG_LEVEL=INFO
WELCOME_CREDITS=60

# Observability is opt-in. Never put production DSNs or bearer tokens in this file.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_ERROR_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.0
METRICS_ENABLED=false
METRICS_ENDPOINT_ENABLED=false
METRICS_BEARER_TOKEN=
READINESS_REQUIRE_REDIS=true

# Internal operator surface. Keep disabled until migration + smoke test.
# Comma-separated positive Telegram IDs; server-side only, never use a hidden URL as auth.
ADMIN_ENABLED=false
ADMIN_BOOTSTRAP_TELEGRAM_IDS=
ADMIN_RATE_LIMIT_PER_MINUTE=60

# Text moderation and versioned photo-rights consent. Report-only by default.
# The local RU/KK rules are a conservative phrase filter, not an image classifier.
MODERATION_MODE=report
MODERATION_POLICY_VERSION=2026-08-01-v1
MODERATION_EXTERNAL_PROVIDER=none
MODERATION_EXTERNAL_FAILURE_POLICY=open
MODERATION_MAX_REQUESTS_PER_MINUTE=30
MODERATION_REPEAT_VIOLATION_THRESHOLD=3
MODERATION_VIOLATION_WINDOW_HOURS=24
PHOTO_RIGHTS_CONSENT_VERSION=2026-08-01-v1
OPENAI_MODERATION_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_MODERATION_BASE_URL=https://api.openai.com/v1
OPENAI_MODERATION_TIMEOUT_SECONDS=10

# Canonical server-side generation templates and deterministic text overlays.
SERVER_TEMPLATES_ENABLED=true
TEMPLATE_COMPOSITOR_ENABLED=true

# Telegram
BOT_TOKEN=
MINI_APP_URL=https://app.kelbet.ai
SUPPORT_USERNAME=@solokarma0

# Telegram Stars. Every switch stays false until the explicit production gate is evidenced.
PAYMENTS_ENABLED=false
PAYMENT_TERMS_URL=https://kelbet.ai/terms
PAYMENT_TERMS_VERSION=2026-07-30
PAYMENT_REFUND_POLICY_URL=
PAYMENT_SELLER_IDENTITY=
PAYMENT_FINANCE_REVIEW_CONFIRMED=false
PAYMENT_ORDER_TTL_MINUTES=30
STARS_REFUNDS_ENABLED=false
STARS_RECONCILIATION_ENABLED=false
STARS_CANARY_TELEGRAM_IDS=
STARS_REFUND_USER_DAILY_LIMIT=2
STARS_REFUND_OPERATOR_DAILY_LIMIT=20
STARS_REFUND_RETRY_LIMIT=3
STARS_REFUND_PROCESSING_TIMEOUT_SECONDS=300
STARS_RECONCILIATION_PAGE_LIMIT=100

# Referral economics are server-owned. The DB feature flag `referrals` remains false
# after migration and is the independent canary/kill switch.
REFERRAL_BOT_USERNAME=
REFERRAL_INVITER_BONUS_CREDITS=5
REFERRAL_INVITEE_BONUS_CREDITS=2
REFERRAL_MINIMUM_PURCHASE_STARS=50
REFERRAL_WAITING_PERIOD_HOURS=72
REFERRAL_DAILY_REWARD_LIMIT=20
REFERRAL_SUSPICIOUS_DAILY_ATTRIBUTION_THRESHOLD=50

# PostgreSQL
# Host apps connect through port 5433; Docker services override this with postgres:5432.
DATABASE_URL=postgresql+asyncpg://kelbet:kelbet@localhost:5433/kelbet
TEST_DATABASE_URL=postgresql+asyncpg://kelbet:kelbet@localhost:5433/kelbet_test
POSTGRES_USER=kelbet
POSTGRES_PASSWORD=kelbet
POSTGRES_DB=kelbet

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://web.telegram.org,http://localhost:5173

# Telegram Mini App authentication
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
SESSION_TTL_SECONDS=3600
QUOTE_TTL_SECONDS=600

# AI chat
CHAT_PROVIDER=mock
CHAT_CREDIT_COST=1
CHAT_MAX_INPUT_CHARS=2000
CHAT_TIMEOUT_SECONDS=60
PROMPT_ASSISTANT_CREDIT_COST=1
PROMPT_ASSISTANT_MAX_INPUT_CHARS=1200
PROMPT_ASSISTANT_MAX_OUTPUT_CHARS=3000

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://kelbet.ai
OPENROUTER_APP_TITLE=KELBET AI

# OpenAI GPT Image. The `openai_image` database feature flag remains false
# until the separate canary, cost reconciliation, and privacy review are complete.
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_TIMEOUT_SECONDS=120
OPENAI_IMAGE_MAX_OUTPUT_BYTES=20971520

# Object storage: memory | s3
STORAGE_BACKEND=memory
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=kelbet
S3_SECRET_ACCESS_KEY=kelbetkelbet
S3_BUCKET=kelbet-assets
S3_REGION=auto
S3_PRESIGN_TTL_SECONDS=600
UPLOAD_MAX_BYTES=10485760
UPLOAD_TEMP_TTL_HOURS=48

# Generations: inline | arq
GENERATION_QUEUE_BACKEND=inline
WEBHOOK_SECRET=replace-with-a-long-random-secret
WEBHOOK_MAX_BODY_BYTES=65536

# Runway
RUNWAY_API_KEY=
RUNWAY_BASE_URL=https://api.dev.runwayml.com
RUNWAY_API_VERSION=2024-11-06
RUNWAY_HTTP_TIMEOUT_SECONDS=60
RUNWAY_POLL_INTERVAL_SECONDS=5
RUNWAY_POLL_JITTER_SECONDS=2
RUNWAY_IMAGE_TIMEOUT_SECONDS=600
RUNWAY_VIDEO_TIMEOUT_SECONDS=1800
RUNWAY_OUTPUT_HOST_ALLOWLIST=runwayml.com,runwayusercontent.com,amazonaws.com,cdn.runway.test

# Shared Google API key. Image fallback still requires both DB feature flags:
# google_image=false and image_fallback=false until a canary is explicitly configured.
GOOGLE_API_KEY=
GOOGLE_VIDEO_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_VIDEO_TIMEOUT_SECONDS=60
GOOGLE_VIDEO_OUTPUT_HOST_ALLOWLIST=googleapis.com,googleusercontent.com,storage.googleapis.com
GOOGLE_IMAGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_IMAGE_TIMEOUT_SECONDS=120
GOOGLE_IMAGE_MAX_OUTPUT_BYTES=20971520
# Comma-separated whsec_ values support zero-downtime secret rotation.
GOOGLE_WEBHOOK_SIGNING_SECRETS=
GOOGLE_WEBHOOK_MAX_AGE_SECONDS=300
VIDEO_OUTPUT_MAX_BYTES=104857600

# Reliability and abuse limits
TEXT_TIMEOUT_SECONDS=120
STUCK_SUBMITTING_SECONDS=180
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_GENERATIONS_PER_MINUTE=30
RATE_LIMIT_PROMPT_ASSISTANT_PER_MINUTE=10
WORKER_JOB_TIMEOUT_SECONDS=900
MAX_ACTIVE_GENERATIONS_PER_USER=3
MAX_ACTIVE_VIDEO_GENERATIONS_PER_USER=1
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_MAX_ATTEMPTS=8
# Veo Extended workflow (catalog feature flag `veo_extended` is OFF by default)
VEO_EXTENDED_STEP_TIMEOUT_SECONDS=900
VEO_EXTENDED_TOTAL_TIMEOUT_SECONDS=3600
VEO_EXTENDED_STEP_MAX_ATTEMPTS=2
