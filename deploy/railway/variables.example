# Paste these variables into API, Bot and Worker services.
# Replace every REPLACE_* value. Never commit real secrets.

APP_ENV=production
LOG_LEVEL=INFO
WELCOME_CREDITS=5

# Optional observability. Use Railway sealed variables for DSN/token values.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_ERROR_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.0
METRICS_ENABLED=false
METRICS_ENDPOINT_ENABLED=false
METRICS_BEARER_TOKEN=
READINESS_REQUIRE_REDIS=true

# Internal operator surface. Set bootstrap IDs as a Railway sealed variable.
ADMIN_ENABLED=false
ADMIN_BOOTSTRAP_TELEGRAM_IDS=
ADMIN_RATE_LIMIT_PER_MINUTE=60

# Keep report-only for the first canary. External text moderation is opt-in.
MODERATION_MODE=report
MODERATION_POLICY_VERSION=2026-08-01-v1
MODERATION_EXTERNAL_PROVIDER=none
MODERATION_EXTERNAL_FAILURE_POLICY=open
MODERATION_MAX_REQUESTS_PER_MINUTE=30
MODERATION_REPEAT_VIOLATION_THRESHOLD=3
MODERATION_VIOLATION_WINDOW_HOURS=24
PHOTO_RIGHTS_CONSENT_VERSION=2026-08-01-v1
OPENAI_MODERATION_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_MODERATION_BASE_URL=https://api.openai.com/v1
OPENAI_MODERATION_TIMEOUT_SECONDS=10

SERVER_TEMPLATES_ENABLED=true
TEMPLATE_COMPOSITOR_ENABLED=true

# Railway reference variables. Rename Postgres/Redis if your services use other names.
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
MINI_APP_URL=https://REPLACE_WITH_VERCEL_DOMAIN
SUPPORT_USERNAME=
REFERRAL_BOT_USERNAME=
REFERRAL_INVITER_BONUS_CREDITS=5
REFERRAL_INVITEE_BONUS_CREDITS=2
REFERRAL_MINIMUM_PURCHASE_STARS=50
REFERRAL_WAITING_PERIOD_HOURS=72
REFERRAL_DAILY_REWARD_LIMIT=20
REFERRAL_SUSPICIOUS_DAILY_ATTRIBUTION_THRESHOLD=50

# Exact Mini App origin, without a trailing slash.
CORS_ORIGINS=https://REPLACE_WITH_VERCEL_DOMAIN
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
SESSION_TTL_SECONDS=3600
QUOTE_TTL_SECONDS=600

# Production jobs use Redis/ARQ and the bundled worker service.
GENERATION_QUEUE_BACKEND=arq
WORKER_JOB_TIMEOUT_SECONDS=900
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS

# Keep free mock providers for the first deployment test.
CHAT_PROVIDER=mock
OPENROUTER_API_KEY=
RUNWAY_API_KEY=
GOOGLE_API_KEY=

# For full upload/generation testing, configure Cloudflare R2 or another S3 service.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=REPLACE_R2_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_R2_SECRET_KEY
S3_BUCKET=kelbet-assets
S3_REGION=auto
S3_PRESIGN_TTL_SECONDS=600

# Keep Stars disabled until a real public terms/refund page and support are ready.
PAYMENTS_ENABLED=false
PAYMENT_TERMS_URL=
PAYMENT_TERMS_VERSION=2026-07-30
