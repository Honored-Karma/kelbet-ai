{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/Dockerfile.railway",
    "watchPatterns": [
      "/apps/worker/**",
      "/packages/**",
      "/pyproject.toml",
      "/docker/Dockerfile.railway"
    ]
  },
  "deploy": {
    "startCommand": "python -m apps.worker.bundle",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": "0",
    "drainingSeconds": "30"
  }
}
