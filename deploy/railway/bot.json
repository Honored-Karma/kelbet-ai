{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/Dockerfile.railway",
    "watchPatterns": [
      "/apps/bot/**",
      "/packages/**",
      "/pyproject.toml",
      "/docker/Dockerfile.railway"
    ]
  },
  "deploy": {
    "startCommand": "python -m apps.bot",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 0,
    "drainingSeconds": 25
  }
}
